# Variáveis de ambiente usadas neste projeto — NUNCA commite um .env real com
# valores verdadeiros. Este arquivo é só documentação (.env.example).
#
# Atenção: as variáveis abaixo NÃO vivem todas no mesmo lugar. Este projeto usa
# 3 sistemas diferentes de configuração, e cada um precisa ser configurado
# separadamente (preencher só o .env local não é suficiente pra tudo funcionar):
#
#   1) Scripts Python locais (update_news.py, update_spaces.py,
#      atlassian_connect_server.py) — leem de um arquivo .env na raiz do repo
#      (via variáveis de ambiente do sistema/shell, ou uma lib tipo python-dotenv
#      se você adicionar uma).
#   2) GitHub Actions (os 4 workflows em .github/workflows/) — leem de
#      "Settings > Secrets and variables > Actions" no repositório GitHub,
#      não deste arquivo.
#   3) Cloudflare Workers (jira-incidentes-proxy, jira-api-proxy, etc.) — leem
#      de secrets configurados no próprio Worker (Cloudflare Dashboard >
#      Workers > [worker] > Settings > Variables, ou via `wrangler secret put`),
#      não deste arquivo.

# --- Jira / Atlassian ---
# Usado por: scripts Python locais, todos os 4 GitHub Actions, Workers
# jira-incidentes-proxy, jira-api-proxy, jira-help-proxy, jira-incidentes-stats,
# jira-mudancas-stats.
JIRA_URL=https://suaempresa.atlassian.net
JIRA_EMAIL=seu-email@suaempresa.com.br
# Gerar em: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# --- OAuth Atlassian (login do portal) ---
# Usado por: Worker oauth-token-exchange (CLIENT_SECRET nunca deve ir pro
# frontend — fica só como secret do Worker).
ATLASSIAN_OAUTH_CLIENT_ID=
ATLASSIAN_OAUTH_CLIENT_SECRET=

# --- Qualys (dados de vulnerabilidades) ---
# Usado por: Worker qualys-vulnerabilidades-stats.
QUALYS_URL=https://qualysapi.qgX.apps.qualys.com
QUALYS_USER=
QUALYS_PASS=

# --- Proteção dos endpoints de estatísticas (stats) ---
# Usado por: Workers qualys-vulnerabilidades-stats, jira-incidentes-stats,
# jira-mudancas-stats — exigem header "X-Api-Key" batendo com este valor.
API_SECRET=

# --- Flask (backend proxy local opcional) ---
# Usado por: atlassian_connect_server.py
FLASK_DEBUG=false
